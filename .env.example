# Copy to .env and fill in. Never commit the real .env file.

# QuorumX checks these Snapshot spaces in order. Add a public GEN governance
# space when one is available and independently verifiable.
QUORUMX_SNAPSHOT_SPACES=balancer.eth

# Development-only archived fixtures are never enabled implicitly.
QUORUMX_ALLOW_FIXTURES=false

# Verified GenLayer Studionet deployment. Override both values together for a
# different network. Leave RPC URL empty to use the SDK's chain endpoint.
QUORUMX_GENLAYER_NETWORK=studionet
QUORUMX_GENLAYER_RPC_URL=
QUORUMX_CONTRACT_ADDRESS=0x59A6A393e15B43b6a13ac6B31A3fbb19094Bf237
QUORUMX_DUE_DILIGENCE_CONTRACT_ADDRESS=0x55d4b311f5b8ec5948cf0F34Feb05fce79b71760
QUORUMX_ASSESSMENT_VERSION=3
QUORUMX_ENABLE_WRITES=false
QUORUMX_RELEASE_COMMIT=unreleased

# Worker-only operations token. Generate a unique high-entropy value per
# environment, store it in the platform secret store, and rotate after exposure.
QUORUMX_ADMIN_TOKEN=

# Required only for commands that submit transactions.
QUORUMX_GENLAYER_PRIVATE_KEY=

# Database migrations use Neon's direct (non-pooler) connection. Cloudflare
# production traffic uses the HYPERDRIVE binding declared in wrangler.jsonc.
DATABASE_URL_UNPOOLED=
QUORUMX_DATABASE_ROLE_PASSWORD=
