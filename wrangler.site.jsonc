{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quorumx-web",
  "main": "workers/site/src/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "QUORUMX_API_BASE": "https://api.quorumx.dev"
  },
  "routes": [
    {
      "pattern": "quorumx.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.quorumx.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "env": {
    "staging": {
      "name": "quorumx-web-v2-dev",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "services": [
        {
          "binding": "QUORUMX_API",
          "service": "quorumx-api-v2-dev"
        }
      ],
      "vars": {
        "QUORUMX_API_BASE": "https://quorumx-api-v2-dev.judithorluchee.workers.dev"
      }
    }
  }
}
