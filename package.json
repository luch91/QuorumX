{
  "name": "quorumx",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "QuorumX: consensus-backed due diligence for governance proposals.",
  "scripts": {
    "test": "npm run build:particles && jest",
    "test:app": "jest app/tests",
    "typecheck": "tsc --noEmit",
    "build": "tsc && npm run build:particles",
    "build:particles": "esbuild frontend/particle_renderer.js --bundle --format=esm --minify --outfile=frontend/particle_renderer.bundle.js",
    "build:validator": "tsc -p tsconfig.validation.json",
    "typecheck:worker": "npm run cf:types && tsc -p workers/api/tsconfig.json",
    "cf:types": "wrangler types workers/api/worker-configuration.d.ts",
    "cf:deploy": "wrangler deploy",
    "cf:deploy:site": "npm run build:particles && wrangler deploy --config wrangler.site.jsonc",
    "cf:deploy:site:staging": "npm run build:particles && wrangler deploy --config wrangler.site.jsonc --env staging",
    "cf:dry-run:site": "npm run build:particles && wrangler deploy --config wrangler.site.jsonc --dry-run",
    "cf:dry-run:site:staging": "npm run build:particles && wrangler deploy --config wrangler.site.jsonc --env staging --dry-run",
    "cf:dry-run:api": "wrangler deploy --dry-run --env=",
    "db:provision-role": "node scripts/provision_database_role.cjs",
    "db:migrate": "node scripts/migrate_database.cjs",
    "db:verify": "node scripts/verify_database.cjs",
    "verify": "npm run lint:docs && npm run test:ci && npm run typecheck && npm run typecheck:worker && npm run build && npm run verify:cli && npm run build:validator",
    "lint:docs": "npx --yes markdownlint-cli2@0.23.3 README.md CONTRIBUTING.md SECURITY.md app/README.md contracts/README.md database/README.md workers/api/README.md docs/**/*.md",
    "verify:docs": "node scripts/verify_docs.cjs",
    "test:ci": "npm run build:particles && jest --runInBand --ci",
    "validate:quorumx": "npm run build:validator && node dist-validation/scripts/validate_quorumx.js",
    "smoke:studionet": "npm run validate:quorumx",
    "quorumx": "node dist/app/src/cli.js",
    "verify:cli": "node scripts/verify_cli_entrypoints.cjs",
    "test:organization:manifest": "node scripts/velvet_solace.cjs manifest",
    "test:organization:provision": "node scripts/velvet_solace.cjs provision",
    "test:organization:teardown": "node scripts/velvet_solace.cjs teardown",
    "test:organization:e2e": "node scripts/run_velvet_solace_e2e.cjs",
    "test:organization:runtime": "node scripts/verify_velvet_solace_runtime.cjs",
    "test:contracts": "python -m pytest contracts/tests -q",
    "validate:v2:fixture": "node scripts/validate_v2_fixture.cjs",
    "test:genlayer:integration": "bash scripts/run_v3_3_glsim_integration.sh",
    "test:ci:real-seams": "npm run test:contracts && npm run validate:v2:fixture",
    "test:release": "node scripts/run_release_rehearsal.cjs",
    "verify:format3-release": "node scripts/verify_v3_3_release.cjs",
    "check:open-questions": "bash scripts/check_open_questions.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.15.5",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.1",
    "jest": "^30.5.2",
    "lighthouse": "^13.5.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.5.0",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "pg": "^8.16.3",
    "three": "0.186.1",
    "viem": "^2.57.3"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "undici": "7.29.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
